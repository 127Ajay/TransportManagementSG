@model TransportManagementSG.UI.ViewModels.RoleViewModel

@{
    ViewData["Title"] = "Edit Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none">← Back to Roles</a>
        <h3 class="mt-2">Edit Role</h3>
        <small class="text-muted">Update role details</small>
    </div>

    <!-- Card -->
    <div class="card shadow-sm">
        <div class="card-body">

            <!-- Role ID Badge -->
            <div class="mb-3">
                <span class="badge bg-dark">
                    Role ID: @Model.RoleId
                </span>
            </div>

            <form asp-action="Edit" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="RoleId" type="hidden" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Role Name -->
                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label">
                        Role Name <span class="text-danger">*</span>
                    </label>

                    <input asp-for="RoleName" class="form-control" required />

                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="form-check form-switch mb-4">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />

                    <label class="form-check-label" for="IsActive">
                        Active
                    </label>

                    <div class="form-text">
                        Role is available for assignment
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}